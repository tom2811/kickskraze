# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres via Supabase (Project Settings → Database)
DATABASE_URL=

# Stripe (Dashboard → Developers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Nexus-bot (shop assistant). Leave NEXUS_BOT_URL empty to use the local mock.
# Local real bot: NEXUS_BOT_URL=http://localhost:8000
# NEXUS_BOT_API_KEY must match nexus-bot's API_KEY. Leave empty if API_KEY is empty.
# Do not put GROQ_API_KEY here — Groq belongs on the nexus-bot process.
NEXUS_BOT_URL=
NEXUS_BOT_API_KEY=
